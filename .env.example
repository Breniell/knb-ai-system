# ══════════════════════════════════════════════════════════════
# KNB AI System — Variables d'environnement (FICHIER UNIQUE)
# Copier : cp .env.example .env  puis remplir au minimum UNE clé LLM.
#
# Ce fichier est lu par les 3 services :
#   - client (Vite lit le .env racine via envDir: "../")
#   - server (Node charge ../../.env)
#   - ai-services (pydantic-settings lit ../.env et ../../.env)
# ══════════════════════════════════════════════════════════════

NODE_ENV=development

# ══════════════════════════════════════════════════════════════
#  MINIMUM POUR DÉMARRER (2 choses suffisent)
# ══════════════════════════════════════════════════════════════
#
# 1) UNE clé LLM gratuite ci-dessous (Groq recommandé, gratuit).
#    Sans elle, les agents ne renvoient que des modèles figés
#    ("se développer" = avoir une vraie clé LLM).
#
# 2) DEV_NO_AUTH=true (déjà réglé plus bas) → l'app tourne en
#    local SANS configurer Firebase. À passer à false en prod.
# ══════════════════════════════════════════════════════════════

# ── LLM Providers (ordre de priorité : Groq → Gemini → Mistral → OpenRouter → Anthropic)
# Groq : gratuit, rapide — https://console.groq.com/keys
GROQ_API_KEY=
# Gemini : gratuit + active la mémoire sémantique (embeddings) — https://aistudio.google.com
GEMINI_API_KEY=
# Optionnels :
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Recherche / apprentissage web (optionnel) ────────────────
BRAVE_API_KEY=
WEB_LEARNING_ENABLED=false

# ── Profil de performance des agents (compromis qualité ↔ quota gratuit) ──
#   quality  = pipeline complet (recherche + raisonnement + 2 révisions) ≈ 8 appels/agent
#   balanced = raisonnement + 1 révision (DÉFAUT, recommandé en plan gratuit) ≈ 5 appels/agent
#   fast     = draft direct + critique légère, sans recherche ≈ 2-3 appels/agent
# Astuce : "balanced" pour le quotidien, "quality" pour un livrable client important,
# "fast" pour itérer/déboguer sans épuiser le quota Groq (14 400 req/jour).
KNB_PERF_PROFILE=balanced

# ══════════════════════════════════════════════════════════════
#  AUTHENTIFICATION
# ══════════════════════════════════════════════════════════════
# true  = pas besoin de Firebase, idéal pour développer/tester en local.
# false = login Firebase obligatoire (remplir les VITE_FIREBASE_* + le compte
#         de service serveur ci-dessous).
DEV_NO_AUTH=true

# ── Firebase (UNIQUEMENT si DEV_NO_AUTH=false) ───────────────
FIREBASE_PROJECT_ID=knb-ai-system
FIREBASE_AUTH_DOMAIN=knb-ai-system.firebaseapp.com
FIREBASE_STORAGE_BUCKET=knb-ai-system.firebasestorage.app
# Compte de service Admin (vérification des tokens côté serveur) :
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_WORKFLOW_COLLECTION=workflowExecutions
FIREBASE_DISABLED=true
BOOTSTRAP_ADMIN_EMAILS=admin@knb.local

# ── Firebase côté client (UNIQUEMENT si DEV_NO_AUTH=false) ────
# Laisser VIDE active le mode sans-auth côté client (cohérent avec DEV_NO_AUTH=true).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=knb-ai-system
VITE_FIREBASE_AUTH_DOMAIN=knb-ai-system.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=knb-ai-system.firebasestorage.app

# ══════════════════════════════════════════════════════════════
#  RÉSEAU — port 3001 (le 8080 est souvent pris par Apache/XAMPP)
# ══════════════════════════════════════════════════════════════
SERVER_PORT=3001
SERVER_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
AI_SERVICE_PUBLIC_URL=http://localhost:8000
AI_SERVICE_PORT=8000

VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ══════════════════════════════════════════════════════════════
#  BASES DE DONNÉES (optionnelles en dev — l'app tourne sans)
# ══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://knb:knb_password@localhost:5432/knb?schema=public
POSTGRES_USER=knb
POSTGRES_PASSWORD=knb_password
POSTGRES_DB=knb
POSTGRES_PORT=5432
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=

# ══════════════════════════════════════════════════════════════
#  DÉPLOIEMENT PRODUCTION — Vercel (client) + Render (server)
# ══════════════════════════════════════════════════════════════
#
#  Ces variables ne sont PAS dans ce fichier .env (qui sert au dev local).
#  Elles doivent être ajoutées manuellement dans les dashboards :
#
#  ┌─ VERCEL (client) ─────────────────────────────────────────┐
#  │  Aller sur : vercel.com → Settings → Environment Variables │
#  │                                                            │
#  │  VITE_API_URL=https://knb-server.onrender.com             │
#  │  VITE_WS_URL=https://knb-server.onrender.com              │
#  │                                                            │
#  │  Mode no-auth (sans Firebase, plus simple) :               │
#  │    → laisser VITE_FIREBASE_API_KEY vide                   │
#  │    → s'assurer que DEV_NO_AUTH=true sur Render             │
#  │                                                            │
#  │  Mode avec Firebase (optionnel) :                          │
#  │    VITE_FIREBASE_API_KEY=  (Firebase Console → Paramètres  │
#  │                             du projet → Vos applications)  │
#  │    VITE_FIREBASE_AUTH_DOMAIN=knb-ai-system.firebaseapp.com │
#  │    VITE_FIREBASE_PROJECT_ID=knb-ai-system                  │
#  │    VITE_FIREBASE_STORAGE_BUCKET=knb-ai-system.firebasestorage.app │
#  │    → Ajouter le domaine Vercel dans Firebase Console →    │
#  │      Authentication → Settings → Authorized domains       │
#  └────────────────────────────────────────────────────────────┘
#
#  ┌─ RENDER (server knb-server) ──────────────────────────────┐
#  │  Aller sur : dashboard.render.com → knb-server → Env Vars  │
#  │                                                            │
#  │  DATABASE_URL=    (Render PostgreSQL → Internal DB URL)    │
#  │  DEV_NO_AUTH=true (ou false si Firebase est configuré)     │
#  │  CORS_ORIGINS=https://<ton-projet>.vercel.app              │
#  │  GROQ_API_KEY=    (groq.com/keys — gratuit)                │
#  └────────────────────────────────────────────────────────────┘
#
#  ┌─ RENDER (service knb-ai-service) ─────────────────────────┐
#  │  GROQ_API_KEY=    (même clé que ci-dessus)                 │
#  │  GEMINI_API_KEY=  (optionnel — embeddings mémoire)         │
#  └────────────────────────────────────────────────────────────┘
