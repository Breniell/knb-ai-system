# ═══════════════════════════════════════════════════════════════
# ai-services — Configuration
#
# ⚠️ En local, tu n'as PAS besoin de ce fichier : le service lit
# automatiquement le .env de la RACINE du projet (../.env).
# Configure tout depuis ../.env (copié depuis ../.env.example).
#
# Ce fichier ne sert que si tu déploies ai-services SÉPARÉMENT.
# Dans ce cas, copie-le en .env et remplis au minimum une clé LLM.
# ═══════════════════════════════════════════════════════════════

# ── LLM (au moins une clé) — Groq gratuit recommandé ───────────
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Firebase (optionnel — laisser FIREBASE_DISABLED=true en local)
FIREBASE_DISABLED=true
FIREBASE_PROJECT_ID=knb-ai-system
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_WORKFLOW_COLLECTION=workflowExecutions

# ── Mémoire sémantique (optionnelle) ───────────────────────────
# Laisser vide = désactivée. Pour l'activer : GEMINI_API_KEY + QDRANT_URL.
QDRANT_URL=
QDRANT_API_KEY=

# ── Recherche web (optionnelle) ────────────────────────────────
BRAVE_API_KEY=
WEB_LEARNING_ENABLED=false

# ── Réseau ─────────────────────────────────────────────────────
AI_SERVICE_PORT=8000
